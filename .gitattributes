# 换行由 Git 统一处理，二进制文件自动识别
* text=auto

# Unity YAML 资源使用 UnityYAMLMerge 合并（驱动需在本机 git config 中配置，未配置时退回普通文本合并）
*.unity              merge=unityyamlmerge
*.prefab             merge=unityyamlmerge
*.asset              merge=unityyamlmerge
*.meta               merge=unityyamlmerge
*.mat                merge=unityyamlmerge
*.anim               merge=unityyamlmerge
*.controller         merge=unityyamlmerge
*.overrideController merge=unityyamlmerge
*.playable           merge=unityyamlmerge
*.mask               merge=unityyamlmerge
*.physicMaterial     merge=unityyamlmerge
*.lighting           merge=unityyamlmerge
*.spriteatlas        merge=unityyamlmerge

# 以下二进制资源走 Git LFS；方括号写法同时匹配大小写扩展名（Linux 上匹配区分大小写）

# 3D 模型与源文件
*.[fF][bB][xX]       filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ]       filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
*.[gG][lL][bB]       filter=lfs diff=lfs merge=lfs -text
*.[dD][aA][eE]       filter=lfs diff=lfs merge=lfs -text
*.[aA][bB][cC]       filter=lfs diff=lfs merge=lfs -text
*.[vV][rR][mM]       filter=lfs diff=lfs merge=lfs -text
*.[vV][rR][oO][iI][dD] filter=lfs diff=lfs merge=lfs -text

# 贴图、图像与绘画源文件
