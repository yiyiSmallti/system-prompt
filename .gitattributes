# Unity 烘焙光照数据是二进制 .asset，覆盖上面的 YAML 合并规则
**/LightingData.asset filter=lfs diff=lfs merge=lfs -text

# README 和设定集展示用图片保留为普通 Git 文件，GitHub 页面直接渲染，不占 LFS 流量
assets/** !filter !diff !merge

# 角色高模和烘焙产物体积大，覆盖上一条规则，仍走 Git LFS；同目录的脚本和说明保持普通文本
assets/characters/highpoly/**        filter=lfs diff=lfs merge=lfs -text
assets/characters/highpoly/**/*.md   !filter !diff !merge text=auto
assets/characters/highpoly/**/*.py   !filter !diff !merge text=auto
assets/characters/highpoly/**/*.txt  !filter !diff !merge text=auto
assets/characters/highpoly/**/*.json !filter !diff !merge text=auto
